<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">

        <masterLabel>Case Status Message</masterLabel>

        <isExposed>true</isExposed>

        <description>
                Sends Case status updates between independent LWC components
        </description>

        <lightningMessageFields>
                <fieldName>caseId</fieldName>
                <description>Id of the Case</description>
        </lightningMessageFields>

        <lightningMessageFields>
                <fieldName>caseNumber</fieldName>
                <description>Case Number</description>
        </lightningMessageFields>

        <lightningMessageFields>
                <fieldName>status</fieldName>
                <description>New Case Status</description>
        </lightningMessageFields>

</LightningMessageChannel>